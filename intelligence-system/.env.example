# ============================================================
# OSINT Intelligence System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your bot token:
#   cp .env.example .env
#
# ONLY ONE VALUE IS REQUIRED: DISCORD_BOT_TOKEN
# All data sources are fully public — no other API keys,
# credentials, or authentication of any kind are used.
# ============================================================


# ── Discord Bot (REQUIRED — the only credential needed) ─────
# Your Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here


# ── Scheduling (optional) ────────────────────────────────────
# Time to deliver the daily digest (24-hour HH:MM, always UTC)
DIGEST_TIME_UTC=08:00

# How often to send trending alerts in hours (0 = disabled)
# Example: 6 = every 6 hours | 12 = twice a day | 0 = off
ALERT_INTERVAL_HOURS=0


# ── Collection Tuning (optional) ─────────────────────────────
# Maximum articles to collect per provider per cycle
MAX_ITEMS_PER_PROVIDER=50

# Number of top articles per category in the daily digest
DIGEST_TOP_N=8

# Minimum relevance score to include in digest (0.0–1.0)
MIN_RELEVANCE_SCORE=0.25

# Deduplication fuzzy-match threshold (0.0–1.0; lower = more aggressive)
DEDUP_THRESHOLD=0.75

# HTTP request timeout in seconds
HTTP_TIMEOUT=20

# Custom User-Agent for HTTP requests (identifies your bot)
# HTTP_USER_AGENT=OSINTDigestBot/1.0 (+https://github.com/your-org/osint-digest)

# Additional RSS feeds to include (comma-separated URLs)
# EXTRA_RSS_FEEDS=https://example.com/feed.xml,https://another.com/rss


# ── Logging (optional) ───────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log format: rich (coloured console) | json (structured) | plain (classic)
LOG_FORMAT=rich

# Optional: path to a log file (appended alongside console output)
# LOG_FILE=logs/osint-digest.log


# ── Operation Modes (optional) ───────────────────────────────
# DRY_RUN: collect and process but do NOT post to Discord (no token needed)
DRY_RUN=false

# RUN_ONCE: run a single digest cycle then exit (useful for cron / CI)
RUN_ONCE=false
